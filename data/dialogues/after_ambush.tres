[gd_resource type="Resource" script_class="DialogueDef" format=3]

[ext_resource type="Script" path="res://data/defs/dialogue_line.gd" id="1_line"]
[ext_resource type="Script" path="res://data/defs/dialogue_def.gd" id="2_dialogue"]
[ext_resource type="Texture2D" path="res://assets/sprites/fighter.png" id="8_fighter"]
[ext_resource type="Texture2D" path="res://assets/sprites/rogue.png" id="8_rogue"]
[ext_resource type="Texture2D" path="res://assets/sprites/goblin.png" id="9_goblin"]

[sub_resource type="Resource" id="Line_after_ambush_1"]
script = ExtResource("1_line")
speaker = "Narrateur"
text = "Le gobelin s'effondre parmi les caisses éventrées."

[sub_resource type="Resource" id="Line_after_ambush_2"]
script = ExtResource("1_line")
speaker = "Roublard"
portrait = ExtResource("8_rogue")
text = "Une bourse vide, une dague ébréchée… et un sifflet. Pourquoi un gobelin aurait-il un sifflet ?"

[sub_resource type="Resource" id="Line_after_ambush_3"]
script = ExtResource("1_line")
speaker = "Guerrier"
portrait = ExtResource("8_fighter")
text = "Pour appeler les autres. On souffle un peu, puis on monte voir."

[sub_resource type="Resource" id="Line_after_ambush_4"]
script = ExtResource("1_line")
speaker = "Narrateur"
text = "Plus haut sur la crête, derrière des palissades, la bande les attend."

[resource]
script = ExtResource("2_dialogue")
id = &"after_ambush"
lines = Array[ExtResource("1_line")]([SubResource("Line_after_ambush_1"), SubResource("Line_after_ambush_2"), SubResource("Line_after_ambush_3"), SubResource("Line_after_ambush_4")])
