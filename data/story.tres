[gd_resource type="Resource" script_class="StoryDef" format=3]

[ext_resource type="Script" path="res://data/defs/story_def.gd" id="1_etlnp"]
[ext_resource type="Script" path="res://data/defs/story_step.gd" id="2_1fs8j"]
[ext_resource type="Resource" path="res://data/dialogues/intro.tres" id="3_13xi4"]
[ext_resource type="Resource" path="res://data/encounters/goblin_ambush.tres" id="4_tbdtp"]
[ext_resource type="Resource" path="res://data/dialogues/after_ambush.tres" id="5_after"]
[ext_resource type="Resource" path="res://data/encounters/goblin_band.tres" id="6_band"]
[ext_resource type="Resource" path="res://data/dialogues/victory.tres" id="7_victory"]

[sub_resource type="Resource" id="Resource_intro"]
script = ExtResource("2_1fs8j")
id = &"intro"
dialogue = ExtResource("3_13xi4")
next_step = &"goblin_ambush"

[sub_resource type="Resource" id="Resource_ambush"]
script = ExtResource("2_1fs8j")
id = &"goblin_ambush"
kind = 1
encounter = ExtResource("4_tbdtp")
next_step = &"after_ambush"

[sub_resource type="Resource" id="Resource_after_ambush"]
script = ExtResource("2_1fs8j")
id = &"after_ambush"
dialogue = ExtResource("5_after")
short_rest = true
next_step = &"goblin_band"

[sub_resource type="Resource" id="Resource_band"]
script = ExtResource("2_1fs8j")
id = &"goblin_band"
kind = 1
encounter = ExtResource("6_band")
next_step = &"victory"

[sub_resource type="Resource" id="Resource_victory"]
script = ExtResource("2_1fs8j")
id = &"victory"
dialogue = ExtResource("7_victory")

[resource]
script = ExtResource("1_etlnp")
first_step = &"intro"
steps = Array[ExtResource("2_1fs8j")]([SubResource("Resource_intro"), SubResource("Resource_ambush"), SubResource("Resource_after_ambush"), SubResource("Resource_band"), SubResource("Resource_victory")])
