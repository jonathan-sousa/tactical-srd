## Types de dégâts du SRD 5.2.1. Stockés dès la v1 pour que les résistances
## et vulnérabilités puissent s'y brancher plus tard.
class_name DamageType
extends RefCounted

enum Type {
	ACID,
	BLUDGEONING,
	COLD,
	FIRE,
	FORCE,
	LIGHTNING,
	NECROTIC,
	PIERCING,
	POISON,
	PSYCHIC,
	RADIANT,
	SLASHING,
	THUNDER,
}
